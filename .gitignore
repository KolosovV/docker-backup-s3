# ==============================================================================
# Secrets — NEVER commit
# ==============================================================================
# The real config with the S3 keys and the Telegram token.
# Only backup.conf.example lives in the repository.
backup.conf
backup.conf.bak.*
*.conf.local

# The GPG passphrase file, in case it ends up next to the scripts
.docker-backup-passphrase
*passphrase*
*.key
*.pem

