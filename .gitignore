# Run and installation artifacts
# ==============================================================================
*.log
*.tar.gz
*.tar.gz.gpg
*.rdb.gz
*.sql.gz
db-dumps/
work/
tmp/

# Backup copies made by install.sh / update.sh
*.bak
*.bak.*
*.reverted.*

